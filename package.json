{
  "name": "dsh-versatileds",
  "version": "0.4.4",
  "description": "多功能DS插件：支持 B站小号代理 + QQ 代理（NapCat 小号通道 / 官方机器人通道），UI 为 B站/QQ/通用 三个模块页；QQ 侧支持本地 GPT-SoVITS 语音、Whisper 语音转文字、按账号/按模块的记忆与人设隔离。仅供学习/个人使用，商用需取得所有版权方授权。",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "bili",
    "qq",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE-GLeaves.txt",
    "assets"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "license": "SEE LICENSE IN LICENSE-GLeaves.txt",
  "author": "黑木钟 - GLeaves",
  "icon": "assets/icon.jpg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GLeaves230/dsh-versatileds.git"
  },
  "homepage": "https://github.com/GLeaves230/dsh-versatileds#readme",
  "bugs": {
    "url": "https://github.com/GLeaves230/dsh-versatileds/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "bilibili",
    "qq",
    "napcat",
    "gpt-sovits",
    "voice",
    "ai",
    "qq-bot",
    "official-bot",
    "whisper",
    "stt"
  ]
}
