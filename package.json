{
  "name": "dsh-versatileds-plugin",
  "version": "0.2.7",
  "description": "多功能DS插件：B站 小号代理与 QQ 代理合体，左侧栏一个入口，B站 / QQ 两个模块分页配置",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "bili",
    "qq",
    "lib",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "LICENSE.txt"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "author": "黑木钟 - GLeaves"
}
